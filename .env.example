# Database
DATABASE_URL="postgresql://user:password@localhost:5432/social_scheduler?schema=public"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Encryption for storing tokens (exactly 32 chars)
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# X (Twitter) API
X_CLIENT_ID=xxx
X_CLIENT_SECRET=xxx
X_REDIRECT_URI=http://localhost:3000/api/auth/callback/x
X_WEBHOOK_SECRET=xxx   # for account activity webhooks

# LinkedIn API
LINKEDIN_CLIENT_ID=xxx
LINKEDIN_CLIENT_SECRET=xxx
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# Meta (Instagram + Facebook) API
META_APP_ID=xxx
META_APP_SECRET=xxx
META_REDIRECT_URI=http://localhost:3000/api/auth/callback/meta
META_WEBHOOK_SECRET=xxx  # app secret for x-hub-signature-256

# Vercel Cron Secret (for securing cron endpoint)
CRON_SECRET=your-cron-secret-here

# Queue / Rate Limiting (BullMQ + Redis)
REDIS_URL="redis://localhost:6379"

# Media storage (AWS S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
S3_BUCKET_NAME=social-scheduler-media
S3_CDN_URL=https://cdn.yourdomain.com   # optional

# AI (OpenAI)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Email (SMTP, optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
